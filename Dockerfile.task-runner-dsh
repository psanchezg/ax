FROM node:22-slim

# Pin the DeepSeek Harness CLI. The shipped `headless` profile initializes from
# the package's own templates on first use, so first boot needs no registry
# egress and no profile has to be baked into the image.
ARG DSH_VERSION=0.1.5-rc.2

# The task runner is a cross-compiled Go binary, so the COPY below has to take the
# build that matches the image platform: an arm64 node cannot run an amd64 binary.
# BuildKit derives TARGETARCH from --platform, but the classic builder does not, so
# pass it explicitly (make build-task-runner-dsh passes both together). The default
# keeps the amd64 layout both task-runner Dockerfiles have always used, and the
# check after the COPY turns any mismatch into a failed build instead of a
# container that dies at exec time in the cluster.
ARG TARGETARCH=amd64

RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    openssh-client \
    procps \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Install the CLI as a pinned project instead of a global package.
#
# Two failure modes come from letting npm resolve this tree freely, and both show up
# only at boot inside a task:
#   * a global install drops @deepseek-ai/dsh-sandbox-local on a peer conflict, and
#     dsh dies with "plugin(s) failed to load: @deepseek-ai/dsh-sandbox-local";
#   * a caret range pulls dsh-base@0.1.5-rc.3 while the CLI is 0.1.5-rc.2, and npm
#     nests a second (identical) copy of the plugin under dsh-base, so the loader
#     imports it twice and dies with "Duplicate type name 'DSH_STARTUPINFOW'".
# The override pins the bundle to the CLI's version, and dropping the nested duplicate
# reproduces the layout of a working install: one copy hoisted next to the CLI, which
# the nested dependent still resolves through its parent chain. The assertions below
# fail the build rather than a task.
RUN set -eu; \
    mkdir -p /opt/dsh; \
    cd /opt/dsh; \
    npm init -y > /dev/null; \
    npm pkg set "overrides.@deepseek-ai/dsh-base=${DSH_VERSION}" > /dev/null; \
    npm install --no-audit --no-fund --save-exact "@deepseek-ai/dsh@${DSH_VERSION}" > /dev/null; \
    npm dedupe > /dev/null; \
    rm -rf /opt/dsh/node_modules/@deepseek-ai/dsh-base/node_modules/@deepseek-ai/dsh-sandbox-local; \
    ln -sf /opt/dsh/node_modules/.bin/dsh /usr/local/bin/dsh; \
    rm -rf /root/.npm; \
    dsh --version; \
    count="$(find /opt/dsh/node_modules -name dsh-sandbox-local -type d | wc -l | tr -d ' ')"; \
    test "$count" = "1" || { echo "expected exactly 1 dsh-sandbox-local, found $count" >&2; exit 1; }; \
    base="$(find /opt/dsh/node_modules -path '*dsh-base/package.json' | head -1)"; \
    grep -q "\"version\": \"${DSH_VERSION}\"" "$base" || { echo "dsh-base at $base does not match ${DSH_VERSION}" >&2; exit 1; }

# DSH keeps profiles and session state under $DSH_HOME, which the runner points
# at the durable AX volume so /workspace stays the agent's only file surface.
ENV DSH_HOME=/ax/dsh

COPY bin/linux_${TARGETARCH}/ax-task-runner /usr/local/bin/ax-task-runner

# Fail the build, not the task, when the runner does not match this image's
# platform. od reads e_machine from the ELF header: b700 is AArch64, 3e00 x86-64.
RUN set -eu; \
    case "$(uname -m)" in \
      aarch64|arm64) want=b700 ;; \
      x86_64|amd64)  want=3e00 ;; \
      *) echo "unsupported build architecture: $(uname -m)" >&2; exit 1 ;; \
    esac; \
    got="$(od -An -tx1 -j18 -N2 /usr/local/bin/ax-task-runner | tr -d ' \n')"; \
    if [ "$got" != "$want" ]; then \
      echo "ax-task-runner is $got but this image is $(uname -m) (TARGETARCH=${TARGETARCH})" >&2; \
      echo "build it with: make build-task-runner-dsh TASK_RUNNER_GOARCH=$(uname -m)" >&2; \
      exit 1; \
    fi; \
    echo "ax-task-runner matches $(uname -m): TARGETARCH=${TARGETARCH}, DSH_VERSION=${DSH_VERSION}"

ENTRYPOINT ["/usr/local/bin/ax-task-runner"]
